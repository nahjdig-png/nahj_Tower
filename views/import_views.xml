<?xml version="1.0" encoding="utf-8"?>
<odoo>

  <!-- ── Form View ─────────────────────────────────────────────────────── -->
  <record id="view_nahj_import_wizard_form" model="ir.ui.view">
    <field name="name">nahj.import.wizard.form</field>
    <field name="model">nahj.import.wizard</field>
    <field name="arch" type="xml">
      <form string="Import Units &amp; Residents">
        <field name="state" invisible="1"/>
        <div class="alert alert-info" role="alert"
             invisible="state == 'done'">
          📂 ارفع ملف Excel (.xlsx) أو CSV يحتوي الأعمدة:<br/>
          <b>unit_no, floor, monthly_subscription, resident_name, resident_phone</b><br/>
          Upload an Excel (.xlsx) or CSV file with those columns.
        </div>

        <group invisible="state == 'done'">
          <group string="بيانات الاستيراد / Import Details">
            <field name="tower_id" required="1"
                   options="{'no_quick_create': true, 'no_create': true}"/>
            <field name="import_file" filename="import_file_name"
                   widget="binary" string="ملف الاستيراد / File"/>
            <field name="import_file_name" invisible="1"/>
          </group>
        </group>

        <group invisible="state != 'done'">
          <field name="result_html" widget="html" readonly="1"/>
        </group>

        <footer>
          <button name="action_import" type="object"
                  string="📥 استيراد – Import"
                  class="btn-primary"
                  invisible="state == 'done'"/>
          <button name="action_download_template" type="object"
                  string="⬇ تحميل القالب – Download Template"
                  class="btn-secondary"/>
          <button special="cancel" string="إغلاق – Close"/>
        </footer>
      </form>
    </field>
  </record>

  <!-- ── Window Action ──────────────────────────────────────────────────── -->
  <record id="action_nahj_import_wizard" model="ir.actions.act_window">
    <field name="name">Import Units &amp; Residents</field>
    <field name="res_model">nahj.import.wizard</field>
    <field name="view_mode">form</field>
    <field name="view_id" ref="view_nahj_import_wizard_form"/>
    <field name="target">new</field>
    <field name="context">{}</field>
  </record>

</odoo>
