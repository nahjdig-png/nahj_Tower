<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ═══════════════════════════════════════════════════════
         Expense Category – List View
    ═══════════════════════════════════════════════════════ -->
    <record id="view_nahj_expense_category_list" model="ir.ui.view">
        <field name="name">nahj.expense.category.list</field>
        <field name="model">nahj.expense.category</field>
        <field name="arch" type="xml">
            <tree string="Expense Categories | فئات المصاريف" editable="top">
                <field name="name" string="Category Name | اسم الفئة"/>
                <field name="expense_count" string="Expenses | المصاريف"/>
            </tree>
        </field>
    </record>

    <!-- ═══════════════════════════════════════════════════════
         Expense Category – Action
    ═══════════════════════════════════════════════════════ -->
    <record id="action_nahj_expense_category" model="ir.actions.act_window">
        <field name="name">Expense Categories</field>
        <field name="res_model">nahj.expense.category</field>
        <field name="view_mode">list</field>
    </record>

    <!-- ═══════════════════════════════════════════════════════
         Expense – List View
    ═══════════════════════════════════════════════════════ -->
    <record id="view_nahj_expense_list" model="ir.ui.view">
        <field name="name">nahj.expense.list</field>
        <field name="model">nahj.expense</field>
        <field name="arch" type="xml">
            <tree string="Expenses | المصاريف">
                <field name="date" string="Date | التاريخ"/>
                <field name="tower_id" string="Tower | البرج" optional="show"/>
                <field name="name" string="Description | الوصف"/>
                <field name="category_id" string="Category | الفئة"/>
                <field name="asset_id" string="Asset | الأصل" optional="show"/>
                <field name="vendor" string="Vendor | المورد" optional="show"/>
                <field name="amount" string="Amount | المبلغ"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'confirmed'"
                       decoration-warning="state == 'draft'"
                       optional="show"/>
            </tree>
        </field>
    </record>

    <!-- ═══════════════════════════════════════════════════════
         Expense – Form View
    ═══════════════════════════════════════════════════════ -->
    <record id="view_nahj_expense_form" model="ir.ui.view">
        <field name="name">nahj.expense.form</field>
        <field name="model">nahj.expense</field>
        <field name="arch" type="xml">
            <form string="Expense | مصروف">
                <header>
                    <button name="action_confirm" type="object"
                            string="✓ Confirm | تأكيد" class="btn-primary"
                            invisible="state == 'confirmed'"/>
                    <button name="action_reset_draft" type="object"
                            string="Reset to Draft | إعادة للمسودة" class="btn-secondary"
                            invisible="state == 'draft'"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,confirmed"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <label for="name" string="Description | الوصف"/>
                        <h1>
                            <field name="name" placeholder="Description | الوصف…"/>
                        </h1>
                    </div>

                    <group>
                        <group string="Expense Details | تفاصيل المصروف">
                            <field name="tower_id" string="Tower | البرج"
                                   options="{'no_quick_create': true, 'no_create': true}"/>
                            <field name="category_id" string="Category | الفئة"
                                   options="{'no_quick_create': true, 'no_create': true}"/>
                            <field name="asset_id" string="Asset | الأصل"
                                   domain="[('tower_id', '=', tower_id)]"
                                   options="{'no_quick_create': true, 'no_create': true}"/>
                            <field name="date" string="Date | التاريخ"/>
                            <field name="amount" string="Amount | المبلغ"/>
                        </group>
                        <group string="Vendor &amp; Reference | المورد والمرجع">
                            <field name="vendor"
                                   string="Vendor / Contractor | المورد / المقاول"
                                   placeholder="e.g. ABC Supplies…"/>
                            <field name="invoice_ref"
                                   string="Invoice / Receipt Ref | رقم الفاتورة"
                                   placeholder="e.g. INV-2026-001…"/>
                        </group>
                    </group>

                    <group string="Notes | الملاحظات">
                        <field name="notes" placeholder="Add notes… | أضف ملاحظات…" nolabel="1"/>
                    </group>
                    <group string="Attachments | المرفقات">
                        <field name="attachment_ids" nolabel="1"
                               widget="many2many_binary"/>
                    </group>
                    <group string="Audit Trail | سجل التدقيق" col="4">
                        <field name="create_uid" string="Created by | أنشأ بواسطة" readonly="1"/>
                        <field name="create_date" string="Created on | تاريخ الإنشاء" readonly="1"/>
                        <field name="write_uid" string="Last modified by | آخر تعديل بواسطة" readonly="1"/>
                        <field name="write_date" string="Last modified on | تاريخ آخر تعديل" readonly="1"/>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- ═══════════════════════════════════════════════════════
         Expense – Search View
    ═══════════════════════════════════════════════════════ -->
    <record id="view_nahj_expense_search" model="ir.ui.view">
        <field name="name">nahj.expense.search</field>
        <field name="model">nahj.expense</field>
        <field name="arch" type="xml">
            <search string="Search Expenses | بحث المصاريف">
                <field name="name" string="Description | الوصف"/>
                <field name="tower_id" string="Tower | البرج"/>
                <field name="category_id" string="Category | الفئة"/>
                <field name="asset_id" string="Asset | الأصل"/>
                <separator/>
                <filter string="This Month | هذا الشهر" name="this_month"
                        domain="[('date','&gt;=', context_today().strftime('%Y-%m-01')),
                                 ('date','&lt;=', context_today().strftime('%Y-%m-28'))]"/>
                <group expand="1" string="Group By | تجميع حسب">
                    <filter string="Tower | البرج" name="group_by_tower"
                            context="{'group_by': 'tower_id'}"/>
                    <filter string="Category | الفئة" name="group_by_category"
                            context="{'group_by': 'category_id'}"/>
                    <filter string="Month | الشهر" name="group_by_month"
                            context="{'group_by': 'date:month'}"/>
                    <filter string="Year | السنة" name="group_by_year"
                            context="{'group_by': 'date:year'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- ═══════════════════════════════════════════════════════
         Expense – Action
    ═══════════════════════════════════════════════════════ -->
    <record id="action_nahj_expense" model="ir.actions.act_window">
        <field name="name">Expenses</field>
        <field name="res_model">nahj.expense</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_nahj_expense_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No expenses recorded yet!
            </p>
            <p>Record building expenses such as cleaning, electricity, maintenance, etc.</p>
        </field>
    </record>

</odoo>
