<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">

        <record id="expense_category_doorman" model="nahj.expense.category">
            <field name="name">Doorman / Security | حارس / أمن</field>
        </record>

        <record id="expense_category_electricity" model="nahj.expense.category">
            <field name="name">Electricity | كهرباء</field>
        </record>

        <record id="expense_category_water" model="nahj.expense.category">
            <field name="name">Water | ماء</field>
        </record>

        <record id="expense_category_cleaning" model="nahj.expense.category">
            <field name="name">Cleaning | تنظيف</field>
        </record>

        <record id="expense_category_maintenance" model="nahj.expense.category">
            <field name="name">Maintenance | صيانة</field>
        </record>

        <record id="expense_category_elevator" model="nahj.expense.category">
