        <!-- Receipt Number Sequence -->
        <record id="seq_nahj_subscription_receipt" model="ir.sequence">
            <field name="name">Nahj Tower: Subscription Receipt</field>
            <field name="code">nahj.subscription.receipt</field>
            <field name="prefix">RCP/%(year)s/</field>
            <field name="padding">5</field>
            <field name="number_next">1</field>
            <field name="number_increment">1</field>
            <field name="use_date_range">False</field>
        </record>

    </data>
