<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!-- Overdue Subscription Notification – runs on the 1st of each month -->
        <record id="cron_nahj_overdue_notifications" model="ir.cron">
            <field name="name">Nahj Tower: Overdue Subscription Notifications</field>
            <field name="model_id" ref="nahj_Tower.model_nahj_tower"/>
            <field name="state">code</field>
            <field name="code">model._cron_notify_overdue_subscriptions()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">months</field>
            <field name="numbercall">-1</field>
            <field name="active">True</field>
            <field name="nextcall" eval="(datetime.now() + timedelta(days=1)).replace(hour=8, minute=0, second=0)"/>
        </record>

        <!-- Asset Maintenance Due Check – runs daily -->
        <record id="cron_nahj_asset_maintenance_check" model="ir.cron">
            <field name="name">Nahj Tower: Asset Maintenance Due Check</field>
            <field name="model_id" ref="nahj_Tower.model_nahj_tower_asset"/>
            <field name="state">code</field>
            <field name="code">model._cron_check_maintenance_due()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="numbercall">-1</field>
            <field name="active">True</field>
            <field name="nextcall" eval="(datetime.now() + timedelta(days=1)).replace(hour=7, minute=0, second=0)"/>
        </record>

    </data>
</odoo>
