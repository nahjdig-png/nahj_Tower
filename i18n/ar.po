# ── Validation Messages ───────────────────────────────────────────────────────
msgid "Resident \"%s\" is already assigned to another unit!"
msgstr "الساكن \"%s\" مرتبط بوحدة أخرى بالفعل!"

msgid "A subscription record already exists for unit \"%s\" in %s %s."
msgstr "يوجد سجل اشتراك مسبق للوحدة \"%s\" في %s %s."

msgid "Year must be between 2000 and 2100."
msgstr "يجب أن تكون السنة بين 2000 و 2100."

msgid "This tower has no units."
msgstr "لا توجد وحدات في هذا البرج."

msgid "No occupied units found in this tower. Disable \"Occupied Units Only\" to generate for all units."
msgstr "لا توجد وحدات مشغولة في هذا البرج. قم بإلغاء تفعيل \"الوحدات المشغولة فقط\" لإنشاء اشتراكات لجميع الوحدات."

msgid "Done! Created: %(created)d subscription(s). Skipped (already exist): %(skipped)d."
msgstr "تم! تم إنشاء: %(created)d اشتراك. تم تجاوز (موجودة مسبقاً): %(skipped)d."

msgid "Subscriptions Generated"
msgstr "تم إنشاء الاشتراكات"

msgid "A unit with this number already exists on this floor in the same tower."
msgstr "توجد وحدة بهذا الرقم في نفس الطابق والبرج."

